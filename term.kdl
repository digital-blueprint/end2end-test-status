// https://zellij.dev/documentation/creating-a-layout
layout {
  tab name="main" focus=true {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    pane size="60%" {
      command "lazygit"
    }
    pane split_direction="vertical" size="40%" {
      pane {
        name "backend :8080"
        command "just"
        args "backend"
      }
      pane {
        name "frontend :5173"
        command "just"
        args "frontend"
        focus true
      }
      pane {
        name "seed (press ENTER once the backend is up)"
        command "just"
        args "seed"
        start_suspended true
      }
    }
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
  tab name="term" {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    pane
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
}
